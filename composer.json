{
    "name": "supertext/supertext-sdk",
    "description": "Client for the Supertext AI translation API: translate HTML and texts, with language codes, rate-limit retries and HTML packing handled for you.",
    "type": "library",
    "license": "MIT",
    "keywords": ["supertext", "translation", "ai", "localization", "api", "sdk"],
    "homepage": "https://github.com/Supertext/Supertext-API-SDK-Guide",
    "authors": [
        { "name": "Supertext AG", "homepage": "https://www.supertext.com" }
    ],
    "support": {
        "issues": "https://github.com/Supertext/Supertext-API-SDK-Guide/issues",
        "source": "https://github.com/Supertext/Supertext-API-SDK-Guide",
        "security": "https://github.com/Supertext/Supertext-API-SDK-Guide/security/policy"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "suggest": {
        "ext-curl": "Needed only for the built-in CurlTransport. Not needed when you pass your own HttpTransport (e.g. wrapping Symfony HttpClient or Guzzle)."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "Supertext\\Sdk\\": "sdk/php/src/" }
    },
    "autoload-dev": {
        "psr-4": { "Supertext\\Sdk\\Tests\\": "sdk/php/tests/" }
    },
    "scripts": {
        "test": "phpunit -c sdk/php/phpunit.xml.dist",
        "phpstan": "phpstan analyse -c sdk/php/phpstan.neon"
    },
    "config": {
        "sort-packages": true
    }
}
