<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.supertext</groupId>
  <artifactId>supertext-sdk-kotlin</artifactId>
  <version>0.5.0</version>
  <packaging>jar</packaging>

  <name>Supertext SDK for Kotlin</name>
  <description>Client for the Supertext AI translation API in Kotlin: translate HTML and texts, with language codes, rate-limit retries and HTML packing handled for you.</description>
  <url>https://github.com/Supertext/Supertext-API-SDK-Guide</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <organization>
    <name>Supertext AG</name>
    <url>https://www.supertext.com</url>
  </organization>
  <developers>
    <developer>
      <name>Supertext AG</name>
      <organization>Supertext AG</organization>
      <organizationUrl>https://www.supertext.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/Supertext/Supertext-API-SDK-Guide</url>
    <connection>scm:git:https://github.com/Supertext/Supertext-API-SDK-Guide.git</connection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kotlin.version>2.4.21</kotlin.version>
    <kotlin.compiler.jvmTarget>11</kotlin.compiler.jvmTarget>
    <maven.compiler.release>11</maven.compiler.release>
    <junit.version>5.14.4</junit.version>
  </properties>

  <!-- The only runtime dependency is the Kotlin standard library; HTTP is the JDK's java.net.http. -->
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/kotlin</sourceDirectory>
    <testSourceDirectory>src/test/kotlin</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <configuration>
          <jvmTarget>11</jvmTarget>
          <args>
            <arg>-Xexplicit-api=strict</arg>
            <arg>-Werror</arg>
            <arg>-Xjdk-release=11</arg>
          </args>
        </configuration>
        <executions>
          <execution>
            <id>compile</id>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
          <execution>
            <id>test-compile</id>
            <goals>
              <goal>test-compile</goal>
            </goals>
            <configuration>
              <!-- The conformance program (examples/) is compiled with the tests, never into the jar. -->
              <sourceDirs>
                <sourceDir>src/test/kotlin</sourceDir>
                <sourceDir>examples</sourceDir>
              </sourceDirs>
              <args combine.self="override">
                <arg>-Werror</arg>
                <arg>-Xjdk-release=11</arg>
              </args>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Copies the Kotlin standard library to target/lib for the conformance run (java -cp 'target/lib/*'). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>runtime-classpath</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
            <manifestEntries>
              <Automatic-Module-Name>com.supertext.sdk.kotlin</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
